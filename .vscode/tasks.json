{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy to Raspberry Pi",
      "type": "shell",
      "command": "ssh money-sorter@money-sorter.local \"~/deploy.sh\"",
      "dependsOn": ["Git Commit and Push"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Git Commit and Push",
      "type": "shell",
      "command": "git add .; git commit -m \"${input:commitMessage}\"; git push",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Enter commit message",
      "default": "update"
    }
  ]
}
